{
  "name": "agentfix",
  "version": "1.0.0",
  "description": "Auto-fix errors in your dev server as they happen using AI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agentfix": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "version": "echo '\n⚠️  Don't forget to update CHANGELOG.md!\n'"
  },
  "keywords": [
    "cli",
    "autofix",
    "aifix",
    "agentfix",
    "cursor",
    "claude",
    "ai",
    "developer-tools",
    "debugging",
    "error-fixing"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willgdjones/agentfix.git"
  },
  "homepage": "https://github.com/willgdjones/agentfix#readme",
  "bugs": {
    "url": "https://github.com/willgdjones/agentfix/issues"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.76",
    "@cursor-ai/january": "^0.1.3",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
